{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "machine-learning",
          "format": "url",
          "env": "CLIMATE_PROCESSOR_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "machine-learning": {
      "root": "machine-learning",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "installCommand": "pip install -r api/requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
